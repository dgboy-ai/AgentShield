# AgentShield Backend Configuration
# Copy to .env.local and fill in values

# Database (SQLite for dev, CockroachDB/Postgres for prod)
# Local dev (SQLite):
# DATABASE_URL=sqlite:///./agentshield.db
# CockroachDB prod (set via secret manager — NEVER commit real credentials):
# DATABASE_URL=cockroachdb://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full
# Postgres fallback:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/agentshield

# JWT Authentication (REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=
ENVIRONMENT=development
# Owner dashboard password (REQUIRED in production, min 12 chars)
# OWNER_DASHBOARD_PASSWORD=
# Demo / public access scope
# DEMO_USER_EMAIL=demo@agentshield.local

# CORS origins (comma-separated — for reference; app allows * by default for ChatGPT WebMCP)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.vercel.app

# Signing backend: local (default) or aws_kms (requires AWS_KMS_KEY_ID + AWS credentials)
# SIGNING_BACKEND=local
# AWS_KMS_KEY_ID=alias/agentshield-signing
# AWS_REGION=us-east-1

# Demo / WebMCP public access — judges can call without login
# DEMO_API_TOKEN=demo-judge-token-2026  # Set a stable value and bake into frontend WebMCP tools
# DEMO_ORG_ID=  # optional fixed org for demo; auto-created if empty

# Groq LLM for the dashboard Chat demo (POST /api/chat)
# Get a key at https://console.groq.com/keys � NEVER commit real keys
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
