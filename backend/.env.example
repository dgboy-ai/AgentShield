# AgentShield Backend Configuration
# Copy to .env.local and fill in values

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./agentshield.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/agentshield

# JWT Authentication (REQUIRED in production)
JWT_SECRET_KEY=
ENVIRONMENT=development

# CORS origins (comma-separated — for reference; app allows * by default for ChatGPT WebMCP)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.vercel.app

# Signing backend: local (default) or aws_kms (requires AWS_KMS_KEY_ID + AWS credentials)
# SIGNING_BACKEND=local
# AWS_KMS_KEY_ID=alias/agentshield-signing
# AWS_REGION=us-east-1

# Demo / WebMCP public access — judges can call without login
# DEMO_API_TOKEN=demo-judge-token-2026  # Set a stable value and bake into frontend WebMCP tools
# DEMO_ORG_ID=  # optional fixed org for demo; auto-created if empty
